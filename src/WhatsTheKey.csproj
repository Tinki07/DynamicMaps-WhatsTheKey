<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>DynamicMaps.WhatsTheKey</AssemblyName>
    <RootNamespace>WhatsTheKey</RootNamespace>
    <Description>Right-click a locked door on DynamicMaps to search its key on the flea market</Description>
    <Version>1.0.0</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <PropertyGroup>
    <TarkovDir Condition=" '$(TarkovDir)' == '' ">C:\SPT\</TarkovDir>
    <TarkovManagedDir>$(TarkovDir)EscapeFromTarkov_Data\Managed\</TarkovManagedDir>
    <TarkovBepInExCoreDir>$(TarkovDir)BepInEx\core\</TarkovBepInExCoreDir>
    <TarkovPluginsDir>$(TarkovDir)BepInEx\plugins\</TarkovPluginsDir>
    <PluginFolderName>tinki07-whatsthekey</PluginFolderName>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <Reference>
      <Private>false</Private>
    </Reference>
  </ItemDefinitionGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp" HintPath="$(TarkovManagedDir)Assembly-CSharp.dll" />
    <Reference Include="Comfort" HintPath="$(TarkovManagedDir)Comfort.dll" />
    <Reference Include="Comfort.Unity" HintPath="$(TarkovManagedDir)Comfort.Unity.dll" />
    <Reference Include="Sirenix.Serialization" HintPath="$(TarkovManagedDir)Sirenix.Serialization.dll" />
    <Reference Include="Unity.TextMeshPro" HintPath="$(TarkovManagedDir)Unity.TextMeshPro.dll" />
    <Reference Include="UnityEngine" HintPath="$(TarkovManagedDir)UnityEngine.dll" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(TarkovManagedDir)UnityEngine.CoreModule.dll" />
    <Reference Include="UnityEngine.InputLegacyModule" HintPath="$(TarkovManagedDir)UnityEngine.InputLegacyModule.dll" />
    <Reference Include="UnityEngine.TextRenderingModule" HintPath="$(TarkovManagedDir)UnityEngine.TextRenderingModule.dll" />
    <Reference Include="UnityEngine.UI" HintPath="$(TarkovManagedDir)UnityEngine.UI.dll" />
    <Reference Include="UnityEngine.UIModule" HintPath="$(TarkovManagedDir)UnityEngine.UIModule.dll" />
    <Reference Include="0Harmony" HintPath="$(TarkovBepInExCoreDir)0Harmony.dll" />
    <Reference Include="BepInEx" HintPath="$(TarkovBepInExCoreDir)BepInEx.dll" />
    <Reference Include="spt-reflection" HintPath="$(TarkovPluginsDir)spt\spt-reflection.dll" />
    <Reference Include="DynamicMaps" HintPath="$(TarkovPluginsDir)mpstark-dynamicmaps\DynamicMaps.dll" />
  </ItemGroup>

  <Target Name="CopyToGame" AfterTargets="Build" Condition=" '$(Configuration)' == 'Release' ">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(TarkovPluginsDir)$(PluginFolderName)\" />

    <RemoveDir Directories="$(MSBuildProjectDirectory)\..\release" />
    <Copy SourceFiles="$(TargetPath);$(MSBuildProjectDirectory)\..\LICENSE" DestinationFolder="$(MSBuildProjectDirectory)\..\release\content\BepInEx\plugins\$(PluginFolderName)\" />
    <ZipDirectory SourceDirectory="$(MSBuildProjectDirectory)\..\release\content\" DestinationFile="$(MSBuildProjectDirectory)\..\release\DynamicMaps-WhatsTheKey-$(Version).zip" />
  </Target>
</Project>
